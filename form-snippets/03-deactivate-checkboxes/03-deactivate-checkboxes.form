{
  "components": [
    {
      "label": "Current admins",
      "components": [
        {
          "text": "Name: {{this.name}}",
          "type": "text",
          "layout": {
            "row": "Row_02suug9",
            "columns": null
          },
          "id": "Field_1y1lnez"
        },
        {
          "label": "deactivate",
          "type": "checkbox",
          "layout": {
            "row": "Row_02suug9",
            "columns": null
          },
          "id": "Field_1vrvovc",
          "key": "deactivate",
          "readonly": "=not(this.deactivate) \nand \ncount(adminList[deactivate = true]) = count(adminList) - 1"
        },
        {
          "computeOn": "change",
          "type": "expression",
          "layout": {
            "row": "Row_0kag0gb",
            "columns": null
          },
          "id": "Field_1d5zujc",
          "key": "name",
          "expression": "=this.name"
        },
        {
          "type": "separator",
          "layout": {
            "row": "Row_0dawfpu",
            "columns": null
          },
          "id": "Field_0kn63ef",
          "conditional": {
            "hide": "=adminList[-1].name = this.name"
          }
        }
      ],
      "showOutline": true,
      "isRepeating": true,
      "allowAddRemove": false,
      "defaultRepetitions": 1,
      "type": "dynamiclist",
      "layout": {
        "row": "Row_0fv1enl",
        "columns": null
      },
      "id": "Field_0zysfv0",
      "path": "adminList",
      "disableCollapse": true,
      "verticalAlignment": "center"
    }
  ],
